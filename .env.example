# Copy to .env (make up does this). Local-only values; nothing here is a real secret.
GRAFANA_ADMIN_PASSWORD=local-only-grafana

# Safe defaults; make run recreates the app with the experiment's settings itself.
METRICS_INCLUDE_USER_ID=false
SLOW_TENANT=
SLOW_SECONDS=2.0
SEED=2026
PROMETHEUS_CONFIG=./observability/prometheus/prometheus.yml

# Host ports (everything is bound to 127.0.0.1 only).
APP_HOST_PORT=28082
GRAFANA_HOST_PORT=23000
PROMETHEUS_HOST_PORT=29090
TEMPO_HOST_PORT=23200
